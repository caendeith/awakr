<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Requested by the QR mission plugin, which also asks for it at runtime. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Only requested when the user records their own alarm sound in the editor. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Display over other apps": the only grant that lets a background service put the ring
         screen in front of the app the user is currently looking at, unlocked or not. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Read-only sleep data imported from Health Connect (the watch syncs through its own app). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <!-- USE_EXACT_ALARM is granted at install for alarm-clock apps; SCHEDULE_EXACT_ALARM
         stays declared for older releases and as a user-grantable fallback. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Health Connect lives in a separate package; Android 11+ hides it unless it is declared here.
         Google builds ship com.google.android.apps.healthdata, AOSP/GrapheneOS ship the controller. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.android.healthconnect.controller" />
    </queries>

    <application
        android:name=".AwakrApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Awakr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Awakr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The ring screen draws above the lock screen (showOnLockScreen/turnScreenOn + the code
             in RingActivity), so it must not ask for the device PIN. It shares the app task now:
             after the user unlocks the phone the ring screen is what comes to the front, and a
             singleTask/singleTop launch reuses the live screen for a queued alarm instead of
             recreating it (the ring session state lives in AlarmRingService). -->
        <activity
            android:name=".ui.ring.RingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.Awakr.Ring"
            android:turnScreenOn="true" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".alarm.PreAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.caendeith.awakr.action.PRE_ALERT" />
            </intent-filter>
        </receiver>

        <!-- Wake-up check: the "are you up?" question and the "I am up!" answer. -->
        <receiver
            android:name=".alarm.WakeUpCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.caendeith.awakr.action.WAKE_UP_CHECK" />
                <action android:name="io.github.caendeith.awakr.action.WAKE_UP_CHECK_CONFIRM" />
            </intent-filter>
        </receiver>

        <!-- Wake-up check: the deadline passed without an answer, the alarm rings again. -->
        <receiver
            android:name=".alarm.WakeUpEscalationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.caendeith.awakr.action.WAKE_UP_CHECK_ESCALATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="io.github.caendeith.awakr.ui.widget.AlarmWidgetReceiver"
            android:label="@string/widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alarm_widget_info" />
        </receiver>

        <!-- Health Connect shows this app's permission rationale in its own UI. -->
        <activity
            android:name=".health.HealthConnectRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Awakr">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <service
            android:name=".alarm.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
